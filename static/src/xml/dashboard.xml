<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="remote_dashboard.Dashboard">
        <div class="rd-dashboard">
            <!-- Header -->
            <div class="rd-header">
                <div class="rd-header-left">
                    <h2 class="rd-title" t-out="this.state.dashboardName || 'Dashboard'" />
                    <span class="rd-sync-info" t-if="this.state.lastSync">
                        Última sync: <t t-out="this.formatDate(this.state.lastSync)" />
                    </span>
                    <span class="rd-countdown">
                        <i class="oi" data-icon="hourglass_top" /> <t t-out="this.state.refreshCountdown" />s
                    </span>
                </div>
                <div class="rd-header-center" t-if="this.state.currentTime">
                    <span class="rd-clock">
                        <i class="oi" data-icon="schedule" /> <t t-out="this.state.currentTime" />
                    </span>
                </div>
                <div class="rd-header-right">
                    <div class="rd-zoom-controls">
                        <button class="btn btn-sm rd-zoom-btn" t-on-click="() => this.onZoomOut()" title="Reducir texto">
                            <i class="oi" data-icon="remove" />
                        </button>
                        <span class="rd-zoom-label" t-on-click="() => this.onZoomReset()" title="Restablecer zoom"><t t-out="this.state.zoomLevel" />%</span>
                        <button class="btn btn-sm rd-zoom-btn" t-on-click="() => this.onZoomIn()" title="Agrandar texto">
                            <i class="oi" data-icon="add" />
                        </button>
                    </div>
                    <button class="btn btn-sm btn-outline-primary rd-btn" t-on-click="() => this.onRefresh()" t-att-disabled="this.state.loading">
                        <i class="oi" data-icon="refresh" t-att-class="{'oi-spin': this.state.loading}" /> Actualizar
                    </button>
                    <button class="btn btn-sm btn-outline-secondary rd-btn" t-on-click="() => this.onSyncRemote()" t-att-disabled="this.state.syncing">
                        <i class="oi" data-icon="cloud_download" t-att-class="{'oi-spin': this.state.syncing}" /> Sincronizar
                    </button>
                </div>
            </div>

            <!-- Zoomable content area -->
            <div class="rd-zoomable" t-att-style="'zoom: ' + (this.state.zoomLevel / 100)">

            <!-- Loading -->
            <div class="rd-loading" t-if="this.state.loading and !this.state.configured">
                <i class="oi oi-spin rd-icon-3x" data-icon="progress_activity" />
                <p>Cargando dashboard…</p>
            </div>

            <!-- Not configured -->
            <div class="rd-empty" t-if="!this.state.loading and !this.state.configured">
                <i class="oi rd-icon-3x" data-icon="settings" />
                <p>No hay ninguna configuración de dashboard.</p>
            </div>

            <!-- Columns -->
            <div class="rd-columns-container" t-if="this.state.configured">
                <t t-foreach="this.state.visibleColumns" t-as="colKey" t-key="colKey">
                    <div t-attf-class="rd-column rd-column-#{colKey}">
                        <div class="rd-column-header">
                            <h3 class="rd-column-title">
                                <t t-out="this.getColumnLabel(colKey)" />
                            </h3>
                            <span class="rd-column-count badge">
                                <t t-out="this.getColumnItems(colKey).length" />
                            </span>
                        </div>

                        <div class="rd-column-body">
                            <div class="rd-no-items" t-if="this.getColumnItems(colKey).length === 0">
                                <i class="oi rd-icon-2x" data-icon="check_circle" t-if="colKey === 'mostrador_despachar'" style="color: #27ae60;" />
                                <i class="oi rd-icon-2x" data-icon="inbox" t-if="colKey !== 'mostrador_despachar'" />
                                <p t-if="colKey !== 'mostrador_despachar'">Sin pedidos</p>
                            </div>

                            <t t-foreach="this.getColumnItems(colKey)" t-as="picking" t-key="picking.remote_id">
                                <div t-attf-class="rd-card rd-card-#{colKey}">
                                    <!-- Card top bar: SO number | Partner name | State | Waiting time -->
                                    <div class="rd-card-topbar">
                                        <div class="rd-card-topbar-left">
                                            <a t-if="picking.sale_order_remote_id and picking.origin"
                                               class="rd-card-so rd-remote-link"
                                               t-on-click="(ev) => this.openRemoteSaleOrder(ev, picking.sale_order_remote_id)"
                                               t-att-title="'Abrir pedido: ' + picking.origin"
                                               t-att-style="this.state.soFontSize ? ('font-size: ' + this.state.soFontSize + 'px') : ''">
                                                <t t-out="picking.origin" />
                                            </a>
                                            <span t-elif="picking.origin" class="rd-card-so"
                                                  t-att-style="this.state.soFontSize ? ('font-size: ' + this.state.soFontSize + 'px') : ''">
                                                <t t-out="picking.origin" />
                                            </span>

                                            <span class="rd-card-partner" t-if="picking.partner_name and !this.state.columns[colKey].hide_client_and_products">
                                                <t t-out="picking.partner_name" />
                                            </span>
                                        </div>
                                        <div class="rd-card-topbar-right">
                                            <span t-if="picking.x_tipo_pedido === 'Mostrador Retira'" class="rd-tipo-pedido-badge">
                                                Mostrador Retira
                                            </span>
                                            <span t-attf-class="badge rd-state-badge rd-state-#{picking.state}">
                                                <t t-out="picking.state_label || picking.state" />
                                            </span>
                                            <span class="rd-waiting-badge" t-if="picking.waiting_minutes > 0">
                                                <i class="oi" data-icon="schedule" />
                                                <t t-out="this.formatWaiting(picking.waiting_minutes)" />
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Card body: left sidebar (15%) + right products -->
                                    <div class="rd-card-body">
                                        <!-- Left sidebar: picking # + buttons -->
                                        <div class="rd-card-sidebar">
                                            <a class="rd-picking-number rd-remote-link" t-on-click="(ev) => this.openRemotePicking(ev, picking.remote_id)" t-att-title="'Abrir picking: ' + picking.name">
                                                <t t-out="picking.name" />
                                            </a>
                                            <button t-if="!this.state.columns[colKey].hide_client_and_products"
                                                    class="btn btn-sm btn-outline-secondary rd-sidebar-btn" t-on-click="(ev) => this.onPrintPicking(ev, picking.remote_id)" title="Imprimir PDF (nueva pestaña)">
                                                <i class="oi" data-icon="print" />
                                            </button>
                                            <button t-if="this.state.hasRicohPrinter and !this.state.columns[colKey].hide_client_and_products"
                                                    class="btn btn-sm btn-primary rd-sidebar-btn"
                                                    t-on-click="(ev) => this.onPrintRicoh(ev, picking.remote_id)"
                                                    title="Imprimir en Ricoh (TCP RAW)">
                                                <i class="oi" data-icon="send" />
                                            </button>
                                            <button t-if="this.state.zplLabelMode !== 'none' and this.state.hasZplPrinter and !this.state.columns[colKey].hide_client_and_products"
                                                    class="btn btn-sm btn-warning rd-sidebar-btn"
                                                    t-on-click="(ev) => this.onPrintZPLLabel(ev, picking.remote_id)"
                                                    title="Imprimir Etiqueta ZPL">
                                                <i class="oi" data-icon="barcode" />
                                            </button>
                                            <button t-if="this.state.zplLabelMode !== 'none' and !this.state.columns[colKey].hide_client_and_products"
                                                    class="btn btn-sm btn-info rd-sidebar-btn"
                                                    t-on-click="(ev) => this.onViewZPLLabel(ev, picking.remote_id)"
                                                    title="Ver ZPL">
                                                <i class="oi" data-icon="description" />
                                            </button>
                                            <button t-if="!this.state.columns[colKey].hide_client_and_products"
                                                    class="btn btn-sm btn-success rd-sidebar-btn" t-on-click="(ev) => this.onValidatePicking(ev, picking.remote_id)" title="Validar">
                                                <i class="oi" data-icon="check" />
                                            </button>
                                        </div>

                                        <!-- Right: product lines -->
                                        <div class="rd-card-products" t-if="picking.move_lines and picking.move_lines.length and !this.state.columns[colKey].hide_client_and_products">
                                            <table class="rd-products-table">
                                                <thead>
                                                    <tr>
                                                        <th>Producto</th>
                                                        <th class="text-end">Dem.</th>
                                                        <th class="text-end">Hecho</th>
                                                        <th>UdM</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="picking.move_lines" t-as="ml" t-key="ml_index">
                                                        <tr>
                                                            <td class="rd-product-name" t-out="ml.product_name" />
                                                            <td class="text-end rd-product-qty" t-out="ml.product_qty" />
                                                            <td class="text-end rd-product-qty" t-out="ml.quantity_done" />
                                                            <td class="rd-product-uom" t-out="ml.product_uom" />
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>

            </div><!-- end rd-zoomable -->
        </div>
    </t>
</templates>
